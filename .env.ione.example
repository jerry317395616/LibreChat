DOMAIN_CLIENT=https://agent.myyr.top
DOMAIN_SERVER=https://agent.myyr.top
APP_TITLE=I-ONE Agent
NO_INDEX=true
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
LOG_TO_FILE=true
TRUST_PROXY=1

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_PASSWORD_RESET=false
ALLOW_SHARED_LINKS=false
LIMIT_CONCURRENT_MESSAGES=true
SESSION_EXPIRY=1000 * 60 * 30
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

# Generate every value independently. Never commit the populated .env.ione file.
JWT_SECRET=replace-with-64-random-hex-characters
JWT_REFRESH_SECRET=replace-with-64-random-hex-characters
CREDS_KEY=replace-with-64-random-hex-characters
CREDS_IV=replace-with-32-random-hex-characters
MEILI_MASTER_KEY=replace-with-at-least-32-random-characters
IONE_AGENT_API_TOKEN=replace-with-a-different-long-random-token

UID=1000
GID=1000
LIBRECHAT_IMAGE_TAG=local
